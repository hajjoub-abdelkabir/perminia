# scripts/setup.ps1 creates .env with a random local-only password.
POSTGRES_PASSWORD=replace_with_a_random_local_password
RUNTIME_DB_PASSWORD=replace_with_a_different_random_local_password

# Optional development-only AI. The isolated showcase does not load this file.
STUDENT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
CHAT_ENABLED=false
CHAT_OPENAI_ENABLED=false
CHAT_OPENAI_MODEL=
GROQ_API_KEY=
CHAT_GROQ_MODEL=
CHAT_ALLOW_DRAFT=false
CHAT_USER_DAILY_LIMIT=5
CHAT_GLOBAL_DAILY_LIMIT=10
