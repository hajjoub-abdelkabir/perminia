FROM node:24.21.0-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS web
WORKDIR /web
COPY student/frontend/package*.json ./
RUN npm ci
COPY student/frontend/ ./
ENV VITE_SHOWCASE=true
RUN npm test && npm run build

FROM python:3.13.15-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY student/backend/requirements.txt student/backend/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.txt -c requirements.lock && useradd --create-home --uid 10001 appuser
COPY --chown=appuser:appuser student/backend/ ./
COPY --from=web /web/dist /web
USER appuser
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
